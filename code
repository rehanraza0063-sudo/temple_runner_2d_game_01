<script>

/* =====================================================
   GAME VARIABLES
===================================================== */

let lane = 1;

let score = 0;

let coins = 0;

let lives = 3;

let speed = 6;

let gameRunning = false;

let objects = [];

let spawnTimer;

let scoreTimer;

let animationID;

let tigerDistance = 0;


/* LANE POSITIONS */

const lanes = [

"31%",

"50%",

"69%"

];

const player =
document.getElementById("player");

const tiger =
document.getElementById("tiger");


/* =====================================================
   SOUND
===================================================== */

let audioContext = null;

function initAudio(){

    if(!audioContext){

        audioContext =
        new (
            window.AudioContext ||
            window.webkitAudioContext
        )();

    }

}

function playSound(type){

    initAudio();

    let oscillator =
    audioContext.createOscillator();

    let gain =
    audioContext.createGain();

    oscillator.connect(gain);

    gain.connect(
        audioContext.destination
    );

    let frequency = 440;

    let duration = .12;

    if(type === "coin"){

        frequency = 1000;
        duration = .12;

    }

    if(type === "jump"){

        frequency = 500;
        duration = .18;

    }

    if(type === "hit"){

        frequency = 100;
        duration = .4;

    }

    if(type === "death"){

        frequency = 60;
        duration = .8;

    }

    if(type === "tiger"){

        frequency = 70;
        duration = .35;

    }

    oscillator.frequency.value =
        frequency;

    gain.gain.setValueAtTime(
        .18,
        audioContext.currentTime
    );

    gain.gain.exponentialRampToValueAtTime(
        .001,
        audioContext.currentTime + duration
    );

    oscillator.start();

    oscillator.stop(
        audioContext.currentTime + duration
    );

}


/* =====================================================
   START GAME
===================================================== */

function startGame(){

    initAudio();

    document
    .getElementById("startScreen")
    .style.display="none";

    gameRunning=true;

    score=0;

    coins=0;

    lives=3;

    speed=6;

    tigerDistance=0;

    updateHUD();

    tiger.style.bottom="-50px";

    spawnLoop();

    scoreTimer=setInterval(

        function(){

            if(!gameRunning)
                return;

            score++;

            /* increase speed */

            if(score % 150 === 0){

                speed += .7;

            }

            updateHUD();

        },

        100

    );

}


/* =====================================================
   PLAYER MOVEMENT
===================================================== */

function updatePlayer(){

    player.style.left =
        "calc(" +
        lanes[lane] +
        " - 30px)";

}

function moveLeft(){

    if(!gameRunning)
        return;

    if(lane > 0){

        lane--;

        updatePlayer();

        playSound("jump");

    }

}

function moveRight(){

    if(!gameRunning)
        return;

    if(lane < 2){

        lane++;

        updatePlayer();

        playSound("jump");

    }

}


/* =====================================================
   JUMP
===================================================== */

function jump(){

    if(!gameRunning)
        return;

    if(
        player.classList.contains("jump")
    )
        return;

    player.classList.add("jump");

    playSound("jump");

    setTimeout(

        function(){

            player.classList.remove("jump");

        },

        700

    );

}


/* =====================================================
   SLIDE
===================================================== */

function slide(){

    if(!gameRunning)
        return;

    player.classList.add("slide");

    setTimeout(

        function(){

            player.classList.remove("slide");

        },

        600

    );

}


/* =====================================================
   KEYBOARD
===================================================== */

document.addEventListener(

"keydown",

function(event){

    if(
        event.key==="ArrowLeft" ||
        event.key.toLowerCase()==="a"
    ){

        moveLeft();

    }

    if(
        event.key==="ArrowRight" ||
        event.key.toLowerCase()==="d"
    ){

        moveRight();

    }

    if(
        event.key==="ArrowUp" ||
        event.key===" "
    ){

        jump();

    }

    if(
        event.key==="ArrowDown" ||
        event.key.toLowerCase()==="s"
    ){

        slide();

    }

}

);


/* =====================================================
   SPAWN OBJECTS
===================================================== */

function spawnLoop(){

    if(!gameRunning)
        return;

    spawnObject();

    let delay =
        Math.max(
            400,
            950 - score*.4
        );

    spawnTimer=setTimeout(

        spawnLoop,

        delay

    );

}


/* =====================================================
   CREATE OBJECT
===================================================== */

function spawnObject(){

    let object =
        document.createElement("div");

    let objectLane =
        Math.floor(
            Math.random()*3
        );

    object.style.left =
        "calc(" +
        lanes[objectLane] +
        " - 30px)";

    object.style.top="-130px";

    let random =
        Math.random();

    let type;

    if(random < .25){

        type="coin";

        object.classList.add(
            "object",
            "coin"
        );

    }

    else if(random < .55){

        type="rock";

        object.classList.add(
            "object",
            "rock"
        );

    }

    else if(random < .8){

        type="log";

        object.classList.add(
            "object",
            "log"
        );

    }

    else{

        type="tree";

        object.classList.add(
            "object",
            "tree"
        );

    }

    document
    .getElementById("game")
    .appendChild(object);

    objects.push({

        element:object,

        lane:objectLane,

        type:type,

        y:-130,

        hit:false

    });

}


/* =====================================================
   GAME LOOP
===================================================== */

function gameLoop(){

    if(!gameRunning){

        animationID =
            requestAnimationFrame(
                gameLoop
            );

        return;

    }

    for(
        let i=objects.length-1;
        i>=0;
        i--
    ){

        let obj=objects[i];

        obj.y += speed;

        obj.element.style.top =
            obj.y+"px";


        /* =============================================
           COLLISION AREA
        ============================================= */

        let playerY =
            window.innerHeight-170;

        let collisionDistance =
            90;


        if(

            !obj.hit &&

            obj.lane === lane &&

            obj.y >
                playerY-collisionDistance &&

            obj.y <
                playerY+60

        ){

            if(obj.type==="coin"){

                collectCoin(
                    obj,
                    i
                );

            }

            else{

                /* Jump avoids obstacle */

                if(
                    !player.classList.contains(
                        "jump"
                    )
                ){

                    obstacleHit(
                        obj,
                        i
                    );

                }

            }

        }


        /* remove */

        if(
            obj.y >
            window.innerHeight+150
        ){

            obj.element.remove();

            objects.splice(i,1);

        }

    }


    /* Tiger */

    updateTiger();


    animationID =
        requestAnimationFrame(
            gameLoop
        );

}


/* =====================================================
   COIN
===================================================== */

function collectCoin(
    obj,
    index
){

    coins++;

    score += 25;

    playSound("coin");

    obj.element.remove();

    objects.splice(index,1);

    updateHUD();

}


/* =====================================================
   OBSTACLE HIT
===================================================== */

function obstacleHit(
    obj,
    index
){

    obj.hit=true;

    lives--;

    /* tiger comes closer */

    tigerDistance += 55;

    playSound("hit");

    obj.element.remove();

    objects.splice(index,1);

    updateHUD();


    /* player damage animation */

    player.style.filter =
        "brightness(3)";

    setTimeout(

        function(){

            player.style.filter =
                "brightness(1)";

        },

        180

    );


    /* tiger roar */

    playSound("tiger");


    if(lives<=0){

        endGame();

    }

}


/* =====================================================
   TIGER CHASING PLAYER
===================================================== */

function updateTiger(){

    if(!gameRunning)
        return;


    /*
       Tiger gets closer
       when obstacles are hit.
    */

    let baseBottom=-50;

    let newBottom =
        baseBottom +
        tigerDistance;


    /*
       Maximum distance
       before tiger catches player.
    */

    if(newBottom>65){

        newBottom=65;

    }

    tiger.style.bottom =
        newBottom+"px";


    /*
       If tiger reaches player
    */

    if(
        newBottom>=50
    ){

        endGame();

    }

}


/* =====================================================
   HUD
===================================================== */

function updateHUD(){

    document
    .getElementById("score")
    .textContent =
        Math.floor(score);

    document
    .getElementById("coins")
    .textContent =
        coins;

    document
    .getElementById("lives")
    .textContent =
        lives;

}


/* =====================================================
   GAME OVER
===================================================== */

function endGame(){

    if(!gameRunning)
        return;

    gameRunning=false;

    clearTimeout(
        spawnTimer
    );

    clearInterval(
        scoreTimer
    );

    playSound("death");

    document
    .getElementById("finalScore")
    .textContent =
        Math.floor(score);

    document
    .getElementById("finalCoins")
    .textContent =
        coins;

    document
    .getElementById("gameOver")
    .style.display =
        "flex";

}


/* =====================================================
   RESTART
===================================================== */

function restartGame(){

    clearTimeout(
        spawnTimer
    );

    clearInterval(
        scoreTimer
    );


    objects.forEach(

        function(obj){

            obj.element.remove();

        }

    );

    objects=[];

    lane=1;

    tigerDistance=0;

    updatePlayer();

    tiger.style.bottom="-50px";

    document
    .getElementById("gameOver")
    .style.display =
        "none";

    startGame();

}


/* =====================================================
   START ANIMATION
===================================================== */

updatePlayer();

requestAnimationFrame(
    gameLoop
);

</script>

</body>
</html>
"""


